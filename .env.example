# Environment Configuration for HouseGPT
# Copy this file to .env and modify values as needed

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/housegpt
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housegpt
DB_USER=postgres
DB_PASSWORD=your_password_here

# Model Configuration
LORA_MODEL_PATH=./housegpt-lora-large
BASE_MODEL_NAME=microsoft/DialoGPT-medium
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Audio Configuration
AUDIO_DEVICE_INDEX=0
VOICE_SAMPLE_PATH=./assets/house_voice_sample.wav
WHISPER_MODEL_SIZE=base
SAMPLE_RATE=16000
CHUNK_SIZE=1024

# TTS Configuration
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
ENABLE_VOICE_CLONING=true
TTS_SPEED=1.0
TTS_PITCH=0
TTS_ENERGY=1.2

# Application Settings
MAX_RESPONSE_LENGTH=150
WAKE_WORD_SENSITIVITY=0.7
RAG_TOP_K=3
LOG_LEVEL=INFO
DEBUG_MODE=false

# Performance Settings
MAX_MEMORY_GB=4
ENABLE_GPU=auto
TORCH_DEVICE=auto
CACHE_SIZE_MB=100

# Conversation Settings
SESSION_TIMEOUT_MINUTES=30
LOG_RETENTION_DAYS=30
ENABLE_CONVERSATION_HISTORY=true
ANONYMIZE_LOGS=false

# API Settings (for future extensions)
API_HOST=localhost
API_PORT=8000
ENABLE_API_SERVER=false
API_CORS_ORIGINS=["http://localhost:3000"]

# Development Settings
ENABLE_HOT_RELOAD=false
MOCK_AUDIO_DEVICES=false
MOCK_TTS=false
TEST_MODE=false
